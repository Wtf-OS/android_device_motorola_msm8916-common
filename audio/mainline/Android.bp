cc_library_shared {
    name: "audio.primary.mainline",
    relative_install_path: "hw",
    proprietary: true,
    srcs: ["audio_hw.c"],
    header_libs: ["libhardware_headers"],
    shared_libs: ["liblog", "libtinyalsa"],
    cflags: ["-Wall", "-Werror", "-Wno-unused-parameter"],
}
