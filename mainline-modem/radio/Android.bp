cc_binary {
 name: "android.hardware.radio-service.osprey",
 vendor: true,
 relative_install_path: "hw",
 srcs: ["service.cpp"],
 cflags: ["-Wall", "-Werror", "-Wno-unused-parameter"],
 init_rc: ["radio.rc"],
 vintf_fragments: ["radio.xml"],
 shared_libs: ["libbase", "libbinder_ndk", "android.hardware.radio-V4-ndk", "android.hardware.radio.config-V4-ndk", "android.hardware.radio.modem-V4-ndk", "android.hardware.radio.sim-V4-ndk", "android.hardware.radio.network-V4-ndk", "android.hardware.radio.data-V4-ndk", "android.hardware.radio.messaging-V4-ndk", "android.hardware.radio.voice-V4-ndk"],
 overrides: ["rild"],
}
