// NDK API 35 Freedreno inputs; ELF dependency checks remain enabled.
cc_prebuilt_library_shared {
    name: "libglapi",
    vendor: true,
    compile_multilib: "32",
    srcs: ["libglapi.so"],
    shared_libs: [],
    strip: { none: true },
}

cc_prebuilt_library_shared {
    name: "libgallium_dri",
    vendor: true,
    compile_multilib: "32",
    srcs: ["libgallium_dri.so"],
    shared_libs: ["libcutils", "liblog", "libsync", "libglapi", "libdrm", "libz"],
    strip: { none: true },
}

cc_prebuilt_library_shared {
    name: "libEGL_adreno",
    vendor: true,
    compile_multilib: "32",
    srcs: ["libEGL_adreno.so"],
    relative_install_path: "egl",
    shared_libs: ["libcutils", "libhardware", "liblog", "libnativewindow", "libsync", "libgallium_dri", "libglapi", "libdrm"],
    strip: { none: true },
}

cc_prebuilt_library_shared {
    name: "libGLESv1_CM_adreno",
    vendor: true,
    compile_multilib: "32",
    srcs: ["libGLESv1_CM_adreno.so"],
    relative_install_path: "egl",
    shared_libs: ["libglapi"],
    strip: { none: true },
}

cc_prebuilt_library_shared {
    name: "libGLESv2_adreno",
    vendor: true,
    compile_multilib: "32",
    srcs: ["libGLESv2_adreno.so"],
    relative_install_path: "egl",
    shared_libs: ["libglapi"],
    strip: { none: true },
}
