# DRM hotplug events and the panel backlight used by the mainline composer.
allow hal_graphics_composer_default self:netlink_kobject_uevent_socket { create bind read getattr getopt setopt };
allow hal_graphics_composer_default sysfs_leds:dir r_dir_perms;
allow hal_graphics_composer_default sysfs_leds:file rw_file_perms;
